DATABASE_URL=postgres://postgres:password@localhost:5432/digital_menu
COOKIE_SECURE=false
APP_URL=http://localhost:3000
ROZETTI_STORE_MODE=1
# Change to a unique random value with at least 32 characters for phone OTP verification.
OTP_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Enable sample tenants and demo sign-in only for development or an intentional demo deployment.
DEMO_MODE=false
# Required for notifications when the waiter panel is closed. Generate once with `npx web-push generate-vapid-keys --json`.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
