{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "پل سخت‌افزار منو",
  "version": "0.1.0",
  "identifier": "ir.menuonline.windows-bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "پل سخت‌افزار منو",
        "width": 940,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
