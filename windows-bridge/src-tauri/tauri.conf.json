{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "پل سخت‌افزار منو",
  "version": "0.2.0",
  "identifier": "ir.menuonline.windows-bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MenuPeak | صندوق آفلاین و تجهیزات",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
